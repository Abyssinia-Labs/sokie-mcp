rvers`.","schema":{"type":"string"}},{"name":"search","in":"query","required":false,"schema":{"type":"string"}},{"name":"tool","in":"query","required":false,"description":"Only skills that name this tool.","schema":{"type":"string"}},{"name":"onlyFindings","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string","enum":["name","reads","changed"]}},{"name":"limit","in":"query","required":false,"description":"How many to return, at most 100. Unset: 25.","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"cursor","in":"query","required":false,"description":"`continueCursor` from the page before.","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"page":{"type":"array","items":{"$ref":"#/components/schemas/SkillSummary"}},"continueCursor":{"type":"string"},"isDone":{"type":"boolean"},"splitCursor":{"anyOf":[{"type":"string"},{"type":"null"}]},"pageStatus":{"anyOf":[{"const":"SplitRecommended"},{"const":"SplitRequired"},{"type":"null"}]}},"required":["page","continueCursor","isDone"]}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}}},"/servers/{serverId}/skills/{name}":{"get":{"operationId":"getServerSkill","tags":["Tools"],"summary":"Get a skill","description":"One skill production serves, with the tools it names and what agents may do. Needs `tools:read`.","security":[{"bearer":["tools:read"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"string"}},{"name":"name","in":"path","required":true,"description":"The skill's name.","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Skill"}}}},"default":{"description":"Refused","content":{"applicati