scription":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"page":{"type":"array","items":{"$ref":"#/components/schemas/Deploy"}},"continueCursor":{"type":"string"},"isDone":{"type":"boolean"},"splitCursor":{"anyOf":[{"type":"string"},{"type":"null"}]},"pageStatus":{"anyOf":[{"const":"SplitRecommended"},{"const":"SplitRequired"},{"type":"null"}]}},"required":["page","continueCursor","isDone"]}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}},"post":{"operationId":"deploy","tags":["Deploys"],"summary":"Deploy uploaded files","description":"A deploy's second step: deploys the files at `sourceKey` and answers with the deploy, queued. Follow it with `getDeploy`. It's held for an owner or admin whenever the same person's deploy from the CLI would be. On a server linked to a repository, the next push to its default branch replaces it. Needs `deploys:write`.","security":[{"bearer":["deploys:write"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"sourceKey":{"type":"string","description":"The `key` from `createUpload`, once the files are there."},"base":{"type":"number","description":"The deploy number the files came from. If production has moved on since, nothing deploys and it answers `STALE_BASE`. Unset: deploy them as they are."}},"required":["sourceKey"],"additionalProperties":false}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Deploy"}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}}},"/servers/{serverId}/deploys/{number}":{"get":{"operationId":"getDeployByNumber","tags":["Deploys"],"summary":"Get a deploy by number","description":"One deploy by its number on the server. Needs `deploys:read`.","security":[{"bearer":["deploys:read"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"string"}},{"name":"number","in":"path","required":true,"description":"The deploy's number on the server.","schema":{"type":"number"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Deploy"}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}}},"/deploys/{deploymentId}":{"get":{"operationId":"getDeploy","tags":["Deploys"],"summary":"Get a deploy","description":"One deploy by its id. Follow a deploy, a redeploy or a restore here until it settles: `live`, `failed`, or `held` for an owner or admin. Needs `deploys:read`.","security":[{"bearer":["deploys:read"]}],"parameters":[{"name":"deploymentId","in":"path","required":true,"description":"The deploy's id.","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Deploy"}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}}},"/servers/{serverId}/uploads":{"post":{"operationId":"createUpload","tags":["Deploys"],"summary":"Get an upload URL","description":"A deploy's first step. PUT the server's folder to `url` as one JSON object of each file's path and text, `{\"files\": {\"sokie.json\": \"…\", \"openapi.yaml\": \"…\"}}`, exactly `bytes` long. Then send `key` to `deploy` as `sourceKey`. Needs `deploys:write`.","security":[{"bearer":["deploys:write"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"bytes":{"type":"number","description":"The upload's size in bytes. The URL takes nothing else."}},"required":["bytes"],"additionalProperties":false}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Upload"}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}}},"/servers/{serverId}/redeploy":{"post":{"operationId":"redeploy","tags":["Deploys"],"summary":"Redeploy","description":"Builds the live deploy's source again. Production keeps answering until the new deploy is live. Needs `deploys:write`.","security":[{"bearer":["deploys:write"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeployStarted"}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}}},"/servers/{serverId}/deploys/{number}/restore":{"get":{"operationId":"checkRestore","tags":["Deploys"],"summary":"Check a restore","description":"What restoring this deploy would do, or why it can't be restored. Changes nothing. Needs `deploys:read`.","security":[{"bearer":["deploys:read"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"string"}},{"name":"number","in":"path","required":true,"description":"The deploy's number on the server.","schema":{"type":"number"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RestoreCheck"}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}},"post":{"operationId":"restoreDeploy","tags":["Deploys"],"summary":"Restore a deploy","description":"Deploys an earlier deploy's files again. On a server linked to a repository, production stops following the default branch until it's resumed. Needs `deploys:write`.","security":[{"bearer":["deploys:write"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"string"}},{"name":"number","in":"path","required":true,"description":"The deploy's number on the server.","schema":{"type":"number"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RestoreStarted"}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}}},"/servers/{serverId}/resume":{"post":{"operationId":"resumeDeploys","tags":["Deploys"],"summary":"Follow the default branch again","description":"After a restore on a server linked to a repository: production follows the default branch again and its newest commit deploys. `pin` on getServer says whether production is held on a restore. A server that isn't answers `NOT_PINNED`. Needs `deploys:write`.","security":[{"bearer":["deploys:write"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Resumed"}}}},"default":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Refusal"}}}}}}},"/servers/{serverId}/tools":{"get":{"operationId":"listServerTools","tags":["Tools"],"summary":"List tools","description":"The tools production serves, with today's calls. Needs `tools:read`.","security":[{"bearer":["tools:read"]}],"parameters":[{"name":"serverId","in":"path","required":true,"description":"The server's id, from `getServer` or `listServers`.","schema":{"type":"s